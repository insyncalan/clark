+        if sec.get("type") == "doclinks":
+            for i in c.get("items") or ():
+                if isinstance(i, dict) and i.get("kind") == "link":
+                    out.append((_s(i.get("label")) or _s(i.get("href")), "link", _s(i.get("href")), ""))
+                elif isinstance(i, dict) and i.get("kind") == "file":
+                    out.append((_s(i.get("label")) or _s(i.get("name")), "file", "", ""))
+        elif sec.get("type") == "linkcard" and _s(c.get("href")):
+            out.append((_s(c.get("title")) or _s(c.get("href")), "link", _s(c.get("href")), ""))
+        elif sec.get("type") == "onedoc" and isinstance(c.get("file"), dict):
+            out.append((_s(c.get("label")) or _s(c["file"].get("name")), "file", "", ""))
+    return out
