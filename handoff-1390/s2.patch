+class ClientCopy(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.pub = publish.select(fx.inputs(fx.load()))
+        cls.wb = load_workbook(io.BytesIO(excel_client.workbook_bytes(cls.pub)))
+
+    def test_the_report_comes_first_and_the_client_copy_has_no_internal_tag_and_no_history(self):
+        self.assertEqual(self.wb.sheetnames[0], "Report")
+        values = cells(self.wb["Report"])
+        self.assertNotIn("INTERNAL", values)
+        self.assertNotIn("History", self.wb.sheetnames)
+        self.assertEqual(self.wb["Report"].sheet_state, "visible")
+
+    def test_the_client_report_has_no_sending_back_ids_or_where_to_edit_lines(self):
+        text = " ".join(str(v) for v in cells(self.wb["Report"]))
+        for gone in (excel_cover.IDS, excel_cover.WHERE_TO_EDIT, "send the file back"):
+            self.assertNotIn(gone, text)
+        self.assertIn(excel_cover.CAUTION, text)
+
+    def test_no_heading_in_the_client_copy_says_client_visible_or_internal_note(self):
+        for ws in self.wb.worksheets:
+            for v in cells(ws):
+                if isinstance(v, str):
+                    self.assertNotIn("client visible", v.lower(), (ws.title, v))
+                    self.assertNotIn("client-visible", v.lower(), (ws.title, v))
+                    self.assertNotIn("internal note", v.lower(), (ws.title, v))
+
+    def test_every_row_of_every_sheet_is_a_row_the_published_page_holds(self):
+        for table in excel_client.sheet_tables(self.pub):
+            ws = self.wb[excel.SHEET_OF[table]]
+            ids = {ws.cell(r, 1).value for r in range(5, ws.max_row + 1) if ws.cell(r, 1).value}
+            self.assertLessEqual(ids, {r["id"] for r in self.pub["data"][table]}, table)
+
+    def test_the_sheets_table_lists_only_sheets_the_copy_has(self):
+        ws = self.wb["Report"]
+        for row in ws.iter_rows():
+            for c in row:
+                if c.hyperlink:
+                    self.assertIn(c.hyperlink.location.split("!")[0].strip("'"), self.wb.sheetnames)
+
+    def test_the_documents_sheet_is_there_only_with_published_documents(self):
+        pub = publish.select(fx.inputs(fx.load()))
+        pub["data"]["documents"] = [{"title": "Plan", "kind": "Plan", "url": "https://example.com/p", "date": "2030-01-02"}]
+        wb = load_workbook(io.BytesIO(excel_client.workbook_bytes(pub)))
+        self.assertEqual([c.value for c in wb["Documents"][2]][:3], ["Plan", "Plan", "https://example.com/p"])
+        pub["data"]["documents"] = []
+        self.assertNotIn("Documents", load_workbook(io.BytesIO(excel_client.workbook_bytes(pub))).sheetnames)
+
+    def test_the_client_report_uses_the_brand_header_fill(self):
+        wb = load_workbook(io.BytesIO(excel_client.workbook_bytes(self.pub, {"fill": "123456", "text": "FFFFFF"})))
+        self.assertEqual(wb["Report"]["A1"].fill.fgColor.rgb[-6:], "123456")
+        self.assertEqual(wb["Report"]["A1"].font.color.rgb[-6:], "FFFFFF")
+
+    def test_a_client_copy_is_not_imported(self):
+        s = DemoStore()
+        self.addCleanup(s.close)
+        path = Path(tempfile.mkdtemp(prefix="clark-1390s2-c-")) / "client.xlsx"
+        self.addCleanup(shutil.rmtree, path.parent, True)
+        path.write_bytes(excel_client.workbook_bytes(self.pub))
+        plan = xi.read_workbook(s.store, path, "ABC", state_path=path.parent / "state.json")
+        self.assertEqual(plan.changes, [], "a client copy never changes a row")
+        self.assertTrue(plan.unrecorded, "it has no export record, so nothing in it is accepted for the person")
+
+
+if __name__ == "__main__":
+    unittest.main()
