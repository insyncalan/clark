@@ -0,0 +1,253 @@
+"""Row 1390 slice 2: the Dashboard's other sections as lines of the Report sheet (excel_cover.lines), one function for each section type.
+
+Pure: a published section (what publish.select kept, with its `content` or `figures` or `items`) goes in and a list of Cover lines
+comes out ({"kind": "heading" | "text" | "tiles" | "table", ...}). Nothing is read from a store, a file or a clock, and nothing
+outside the published section and the published data it is given. A section with nothing to say gives no lines at all (heading
+included). A picture is never drawn: its place says NO_PICTURE. Every reader is total: a value of the wrong shape is nothing.
+
+The sections the Report sheet draws here: reportheadline, headline, callout, quote, textimage, imagecap, figures3, figures4, table,
+contacts, checklist, keydates, glancetemplate (its tiles) and usecases (the summary strip). The documents sections (docs, doclinks,
+linkcard, onedoc) are the Documents sheet's (documents_rows); the Progress tracker publishes none of its content, so it has no block.
+Standard library only, Python 3.9.
+"""
+from clark import glance_print, sanitise, timefmt
+from clark.section_kinds import reportheadline
+
+NO_PICTURE = "(picture not in this export)"
+MAX_TABLE_COLUMNS = 6                 # the Report's grid has 12 columns: a table of more than this is drawn as text lines
+TONE_OF_LETTER = {"g": "green", "a": "amber", "r": "red", "b": "blue"}      # a figure's rag letter (figures4.publisher)
+USE_CASE_STATUSES = ("On track", "Flag", "High risk", "Done")
+DOCUMENT_COLUMNS = ("Title", "Kind", "Link", "Date")
+
+
+def _s(value):
+    return value.strip() if isinstance(value, str) else ""
+
+
+def _line(kind, text="", **more):
+    line = {"kind": kind, "text": text}
+    line.update(more)
+    return line
+
+
+def _plain(html_or_text):
+    """The words of `html_or_text` as plain lines (never a tag); text that cannot be cleaned is nothing."""
+    text = _s(html_or_text)
+    if not text:
+        return ""
+    try:
+        return sanitise.plain_text(text).strip()
+    except Exception:      # a hostile body the cleaner refuses is left out, as excel_cover.plain does
+        return ""
+
+
+def _heading(sec, fallback):
+    return _line("heading", _s(sec.get("title")) or fallback)
+
+
+def _content(sec):
+    c = sec.get("content")
+    return c if isinstance(c, dict) else {}
+
+
+def _body(lines, sec, fallback):
+    """The section's heading and `lines`, or nothing when there are no lines."""
+    lines = [x for x in lines if x]
+    return [_heading(sec, fallback)] + lines if lines else []
+
+
+def _texts(*parts):
+    return [_line("text", p) for p in parts if _s(p)]
+
+
+def reportheadline_block(sec, published):
+    c = _content(sec)
+    health = c.get("health")
+    word = reportheadline.WORDS.get(health, "") if isinstance(health, str) and health else ""
+    first = " · ".join(p for p in (word, _s(c.get("headline"))) if p)
+    return _body(_texts(first, c.get("sentence")), sec, "Report headline")
+
+
+def headline_block(sec, published):
+    c = _content(sec)
+    parts = list(_texts(c.get("words")))
+    if _s(c.get("label")) and _s(c.get("href")):
+        parts.append(_line("text", f"{_s(c['label'])}: {_s(c['href'])}"))
+    if _s(c.get("image")):
+        parts.append(_line("text", NO_PICTURE))
+    return _body(parts, sec, "Headline")
+
+
+def callout_block(sec, published):
+    c = _content(sec)
+    body = _plain(c.get("html")) or "\n".join(_s(p) for p in c.get("paras") or () if _s(p))
+    return _body(_texts(c.get("title"), body), sec, "Callout")
+
+
+def quote_block(sec, published):
+    c = _content(sec)
+    quote = _s(c.get("quote"))
+    if not quote:
+        return []
