@@ -0,0 +1,304 @@
+"""Row 1390 slice 2: the Report sheet (the Cover, now in the Dashboard's order), the Documents sheet, the hidden History sheet and the
+client copy, from the real export of a demo store, the client workbook of the publish plant, and an older workbook that must still import.
+Fictional data only.
+
+Run: python3 dev/run_tests.py test_excel_report_1390s2
+"""
+import io
+import shutil
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+
+import _paths  # noqa: F401  (puts src/ and vendor/ on the path)
+import _publish_fixture as fx
+from _demo import USER, DemoStore
+from openpyxl import load_workbook
+
+from clark import excel, excel_blocks, excel_client, excel_cover
+from clark import excel_import as xi
+from clark import publish
+
+ON = "2030-06-01"
+
+
+def cells(ws):
+    return [c.value for row in ws.iter_rows() for c in row if c.value is not None]
+
+
+class Blocks(unittest.TestCase):
+    """The pure readers: one published section in, Cover lines out; a value of the wrong shape is nothing."""
+
+    def sec(self, type_, **more):
+        return {"id": "s1", "type": type_, "title": "T", **more}
+
+    def kinds(self, lines):
+        return [x["kind"] for x in lines]
+
+    def test_a_reader_for_every_type_the_ticket_names(self):
+        self.assertEqual(set(excel_blocks.BLOCKS), {"reportheadline", "headline", "callout", "quote", "textimage", "imagecap", "figures3", "figures4",
+                                                     "table", "contacts", "checklist", "keydates", "glancetemplate", "usecases"})
+
+    def test_report_headline_is_the_health_word_the_headline_and_the_sentence(self):
+        got = excel_blocks.block(self.sec("reportheadline", content={"health": "at_risk", "headline": "Slipping", "sentence": "Two weeks late."}), {})
+        self.assertEqual([x["text"] for x in got], ["T", "At risk · Slipping", "Two weeks late."])
+
+    def test_a_picture_says_it_is_not_in_the_export(self):
+        got = excel_blocks.block(self.sec("imagecap", content={"image": "data:x", "caption": "The site"}), {})
+        self.assertEqual([x["text"] for x in got], ["T", excel_blocks.NO_PICTURE, "The site"])
+        got = excel_blocks.block(self.sec("textimage", content={"words": ["Hello"], "image": "data:x", "caption": "Cap"}), {})
+        self.assertEqual([x["text"] for x in got][1:], ["Hello", excel_blocks.NO_PICTURE + " Cap"])
+        self.assertEqual(excel_blocks.block(self.sec("imagecap", content={"caption": "no picture"}), {}), [])
+
+    def test_callout_quote_and_headline(self):
+        got = excel_blocks.block(self.sec("callout", content={"title": "Note", "paras": ["a", "b"]}), {})
+        self.assertEqual([x["text"] for x in got], ["T", "Note", "a\nb"])
+        got = excel_blocks.block(self.sec("quote", content={"quote": "Fine", "by": "Ada", "role": "Sponsor"}), {})
+        self.assertEqual(got[1]["text"], "“Fine” – Ada, Sponsor")
+        got = excel_blocks.block(self.sec("headline", content={"words": "Go", "label": "Open", "href": "https://example.com/x", "image": "i"}), {})
+        self.assertEqual([x["text"] for x in got][1:], ["Go", "Open: https://example.com/x", excel_blocks.NO_PICTURE])
+
+    def test_figures_are_tiles_with_the_rag_colour(self):
+        got = excel_blocks.block(self.sec("figures3", figures=[{"label": "Spend", "value": "12k", "detail": "of 20k", "rag": "a", "asof": "01-06-2030"},
+                                                               {"label": "", "value": "x"}]), {})
+        (tiles,) = [x for x in got if x["kind"] == "tiles"]
+        self.assertEqual(tiles["tiles"], [{"tile": "figure", "title": "Spend", "value": "12k", "detail": "of 20k as of 01-06-2030", "colour": "amber"}])
+
+    def test_table_contacts_checklist_and_key_dates(self):
+        got = excel_blocks.block(self.sec("table", content={"cols": ["A", "B"], "rows": [["1", "2"], ["3"]], "caption": "Cap"}), {})
+        self.assertEqual(got[1]["rows"], [["1", "2"], ["3", ""]])
+        self.assertEqual(got[2]["text"], "Cap")
+        wide = excel_blocks.block(self.sec("table", content={"cols": list("ABCDEFGH"), "rows": [list("12345678")]}), {})
+        self.assertEqual(self.kinds(wide), ["heading", "text", "text"], "a table too wide for the grid is words, one line a row")
+        got = excel_blocks.block(self.sec("contacts", content={"people": [{"name": "Ada", "role": "PM", "email": "a@example.com", "phone": ""}]}), {})
+        self.assertEqual(got[1]["rows"], [["Ada", "PM", "a@example.com", ""]])
+        pub = {"data": {"actions": [{"id": "ABC-A-001", "description": "Do it", "status": "Closed"}], "milestones": [
+            {"id": "ABC-M-001", "name": "Live", "forecast_date": "2030-07-01", "status": "Open"}]}}
+        got = excel_blocks.block(self.sec("checklist", items=[{"text": "Plan", "done": 1}, {"item": "ABC-A-001"}, {"item": "ABC-A-999"}]), pub)
+        self.assertEqual(got[1]["rows"], [["Done", "Plan"], ["Done", "ABC-A-001: Do it"]], "an item that is not published is not named")
+        got = excel_blocks.block(self.sec("keydates", items=[{"label": "Kick-off", "date": "2030-01-02"}, {"milestone": "ABC-M-001"}]), pub)
+        self.assertEqual(got[1]["rows"], [["02-01-2030", "Kick-off"], ["01-07-2030", "ABC-M-001: Live"]])
+
+    def test_use_case_strip_counts_by_status(self):
+        pub = {"data": {"use_cases": [{"status": "On track"}, {"status": "On track"}, {"status": "Flag"}]}}
+        got = excel_blocks.block(self.sec("usecases"), pub)
+        self.assertEqual(got[1]["cols"], ["Use cases", "On track", "Flag"])
+        self.assertEqual(got[1]["rows"], [["3", "2", "1"]])
+        self.assertEqual(excel_blocks.block(self.sec("usecases"), {"data": {"use_cases": []}}), [])
+
+    def test_a_section_that_cannot_be_read_is_left_out_not_raised(self):
+        for t in excel_blocks.BLOCKS:
+            self.assertEqual(excel_blocks.block({"type": t, "content": 5, "items": 7, "figures": "x"}, {"data": 3}), [], t)
+        self.assertEqual(excel_blocks.block({"type": "docs"}, {}), [])
+
+    def test_open_risks_and_issues_by_type(self):
+        rows = [{"type": "Risk", "status": "Open"}, {"type": "Risk", "status": "Closed"}, {"type": "Issue", "status": "Open"}, {"type": "Assumption", "status": "Open"}]
+        self.assertEqual(excel_blocks.raid_counts({"data": {"raid": rows}}), [("Assumption", 1), ("Issue", 1), ("Risk", 1)])
+
+    def test_documents_rows_never_carry_a_path(self):
+        pub = {"data": {"documents": [{"title": "Plan", "kind": "Plan", "url": "https://example.com/p", "date": "2030-01-02"}]},
+               "sections": [{"type": "doclinks", "content": {"items": [{"kind": "link", "href": "https://example.com/l", "label": "L"},
+                                                                       {"kind": "file", "name": "a.pdf", "rel": "secret/folder/a.pdf", "bytes": 3, "label": ""}]}}]}
+        rows = excel_blocks.documents_rows(pub)
+        self.assertEqual(rows, [("Plan", "Plan", "https://example.com/p", "2030-01-02"), ("L", "link", "https://example.com/l", ""), ("a.pdf", "file", "", "")])
+        self.assertNotIn("secret", repr(rows))
+
+
+class EditorExport(unittest.TestCase):
+    def setUp(self):
+        self.demo = DemoStore()
+        self.s = self.demo.store
+        self.dir = Path(tempfile.mkdtemp(prefix="clark-1390s2-"))
+        self.addCleanup(shutil.rmtree, self.dir, True)
+        self.addCleanup(self.demo.close)
+        self.path, self.state = self.dir / "ABC work items.xlsx", self.dir / "state.json"
+        self.demo.action(description="An open action", due_date="2030-01-01")
+        with self.s.step("dashboard", USER) as st:
+            st.create("raid", {"project": "ABC", "type": "Risk", "description": "A risk", "status": "Open", "raised": "2030-01-01", "source": "demo"})
+            st.create("raid", {"project": "ABC", "type": "Issue", "description": "An issue", "status": "Open", "raised": "2030-01-01", "source": "demo"})
+            st.create("documents", {"project": "ABC", "title": "Delivery plan", "kind": "Plan", "url": "https://example.com/plan", "sort_order": 1})
+        con = sqlite3.connect(self.s.path)
+        con.execute("UPDATE projects SET client_name = 'Example Client', week_ending = '2030-05-31' WHERE code = 'ABC'")
+        con.execute("DELETE FROM report_sections WHERE project = 'ABC'")
+        con.execute("INSERT INTO report_sections (project, id, type, title, body, beside, hidden, sort_order) VALUES "
+                    "('ABC','a','current','Current state','',0,0,1), ('ABC','b','glance','At a glance','',0,0,2), "
+                    "('ABC','m','milestones','Milestones','',0,0,20), ('ABC','n','raid','Risks','',0,0,21), "
+                    "('ABC','o','actions','Actions','',0,0,22), ('ABC','p','decisions','Decisions','',0,0,23), "
+                    "('ABC','q','usecases','Use cases','',0,0,24), ('ABC','r','docs','Documents','',0,0,25)")
+        con.commit()
+        con.close()
+
+    def make(self, **kw):
+        excel.export_project(self.s, "ABC", self.path, self.state, on=ON, exported_by="Sam Example", **kw)
+        return load_workbook(self.path)
+
+    def test_the_first_sheet_is_the_report_and_no_sheet_is_called_cover(self):
+        wb = self.make()
+        self.assertEqual(wb.sheetnames, ["Report", "Actions", "Risks & Issues", "Decisions", "Milestones", "Use cases", "Documents", "History", "Lists", excel.META_NAME])
+        self.assertEqual(wb.active.title, "Report")
+        self.assertNotIn("Cover", wb.sheetnames)
+
+    def test_history_is_hidden_and_the_report_says_how_to_unhide_it(self):
+        wb = self.make()
+        self.assertEqual(wb["History"].sheet_state, "hidden")
+        self.assertEqual(wb["Report"].sheet_state, "visible")
+        self.assertIn(excel_cover.UNHIDE_HISTORY, cells(wb["Report"]))
+        self.assertEqual([ws.title for ws in wb.worksheets if ws.sheet_state == "visible"], ["Report", "Actions", "Risks & Issues", "Decisions", "Milestones", "Use cases", "Documents"])
+
+    def test_the_subtitle_is_the_dashboard_header_with_no_client(self):
+        col = cells(self.make()["Report"])
+        self.assertIn("Weekly report · Week ending 31-05-2030", col)
+        self.assertFalse([v for v in col if isinstance(v, str) and "Example Client" in v])
+
+    def test_shown_as_at_only_when_an_as_at_day_is_given(self):
+        self.assertFalse([v for v in cells(self.make()["Report"]) if str(v).startswith(excel_cover.AS_AT)])
+        self.path.unlink()
+        self.assertIn("Shown as at 15-05-2030", cells(self.make(as_at="2030-05-15")["Report"]))
+
+    def test_the_sheets_table_links_each_name_to_its_tab(self):
+        ws = self.make()["Report"]
+        links = {c.value: c.hyperlink.location for row in ws.iter_rows() for c in row if c.hyperlink}
