+        parts.append(_line("text", NO_PICTURE + (f" {_s(c.get('caption'))}" if _s(c.get("caption")) else "")))
+    return _body(parts, sec, "Text and image")
+
+
+def imagecap_block(sec, published):
+    c = _content(sec)
+    if not _s(c.get("image")):
+        return []
+    return _body(_texts(NO_PICTURE, c.get("caption")), sec, "Image")
+
+
+def figures_block(sec, published):
+    tiles = []
+    for f in sec.get("figures") or ():
+        if not isinstance(f, dict) or not _s(f.get("label")):
+            continue
+        detail = " ".join(p for p in (_s(f.get("detail")), f"as of {_s(f.get('asof'))}" if _s(f.get("asof")) else "") if p)
+        tiles.append({"tile": "figure", "title": _s(f.get("label")), "value": str(f.get("value", "")), "detail": detail,
