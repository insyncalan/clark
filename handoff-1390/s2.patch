+    given a path. No rows is []."""
+    out = []
+    for d in (rows if rows is not None else ((published or {}).get("data") or {}).get("documents")) or ():
+        if isinstance(d, dict) and (_s(d.get("title")) or _s(d.get("url"))):
+            out.append((_s(d.get("title")), _s(d.get("kind")), _s(d.get("url")), _s(d.get("date"))))
+    for sec in (published or {}).get("sections") or ():
+        if not isinstance(sec, dict):
