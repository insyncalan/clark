# LF everywhere, so the same files work on the Mac now and Windows later (BRD NFR-9).
* text=auto eol=lf

# Windows launchers need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
*.docx binary
*.pptx binary
*.pdf binary
*.zip binary
*.db binary

# The built page files are a pure function of their sources (dev/tools/build_page.py), so a merge rebuilds them instead of
# merging text. Needs the one set-up command per clone: python3 dev/tools/install_merge_driver.py (README.md, "For people who build clark").
src/clark/page/page.html merge=clark-page
src/clark/page/page-view.html merge=clark-page
