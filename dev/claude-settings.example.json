{
  "_comment": "Example Claude Code permissions baseline for working on this repo. Install: copy to ~/.claude/settings.json, or merge the allow and deny arrays into your existing file. The repo's .claude/ folder stays private and is never committed. gh api is deliberately not allowed. The -R form of each gh command is covered by the prefix match.",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push origin refs/heads/main:*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --tags:*)",
      "Bash(git push * --tags*)",
      "Bash(git push --delete:*)",
      "Bash(git push * --delete *)",
      "Bash(git push origin :*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth:*)",
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(git config --global user.name:*)",
      "Bash(git config --global user.email:*)"
    ]
  }
}
