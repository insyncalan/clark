{
  "_comment": "Example Claude Code permissions baseline for working on this repo. Install: copy to ~/.claude/settings.json, or merge the allow and deny arrays into your existing file. The repo's .claude/ folder stays private and is never committed. These prefix rules are a guardrail only: wrappers (bash -c, env, xargs, git -C x push) and compound commands get past them. Branch protection on main is the real control. The matcher syntax is a reading of the docs and is untested against the real tool. The -R form of gh commands (gh -R x pr view) is not matched.",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue close:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh run cancel:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push origin refs/heads/main:*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --tags:*)",
      "Bash(git push * --tags*)",
      "Bash(git push --delete:*)",
      "Bash(git push * --delete *)",
      "Bash(git push origin :*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth:*)",
      "Bash(git config --global user.name:*)",
      "Bash(git config --global user.email:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * refs/heads/*:refs/heads/main)",
      "Bash(git push * +*)",
      "Bash(git push origin +HEAD:main:*)",
      "Bash(git push * -f)",
      "Bash(git push origin refs/tags/*)",
      "Bash(git push origin tag *)",
      "Bash(git push * :*)",
      "Bash(git push -d:*)",
      "Bash(git push * -d *)",
      "Bash(git push --mirror:*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all:*)",
      "Bash(git push * --all*)",
      "Bash(git push --prune:*)",
      "Bash(git push * --prune*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X *)",
      "Bash(gh api -f*)",
      "Bash(gh api * -f *)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input *)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git config --local user.name:*)",
      "Bash(git config --local user.email:*)",
      "Bash(git config --system:*)",
      "Bash(git config --unset:*)",
      "Bash(git config --add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout --force:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fx:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)"
    ]
  }
}
